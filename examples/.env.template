# @moderation-api/sdk SDK Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Security Configuration
# The SDK supports loading security credentials from environment variables
# with the prefix: MODAPI_
#
# Security environment variables:
MODAPI_SECRET_KEY=your_secretkey_here

# Debug Configuration
# Enable HTTP request/response logging for debugging
MODAPI_DEBUG=true
