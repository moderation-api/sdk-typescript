{
  "name": "@moderation-api/sdk",
  "version": "5.4.0",
  "author": "Moderation API",
  "license": "Apache-2.0",
  "type": "module",
  "tshy": {
    "compiler": "tsgo",
    "sourceDialects": [
      "@moderation-api/sdk/source"
    ],
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json",
      "./types": "./src/types/index.ts",
      "./models/errors": "./src/models/errors/index.ts",
      "./models": "./src/models/index.ts",
      "./models/operations": "./src/models/operations/index.ts",
      "./*.js": "./src/*.ts",
      "./*": "./src/*.ts"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/moderation-api/sdk-typescript"
  },
  "scripts": {
    "lint": "oxlint --max-warnings=0 --deny-warnings --no-error-on-unmatched-pattern src",
    "build": "tshy",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260302.1",
    "oxlint": "^1.60.0",
    "tshy": "^3.3.2",
    "typescript": "~5.8.3"
  },
  "dependencies": {
    "zod": "^3.25.65 || ^4.0.0"
  }
}
